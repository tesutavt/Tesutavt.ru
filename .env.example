# --- Postgres (используется docker-compose.yml для контейнера БД) ---
POSTGRES_USER=vtube
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vtube_overlay

# Строка подключения для самого приложения. При запуске через
# docker-compose.yml переопределяется автоматически (адрес "postgres"
# внутри docker-сети) - эта строка нужна только для локального запуска
# без Docker.
DATABASE_URL="postgresql://vtube:change-me@localhost:5432/vtube_overlay"

# --- Auth.js ---
# Сгенерировать: npx auth secret
AUTH_SECRET="generate-with-npx-auth-secret"
# Публичный адрес сайта - в продакшене обязательно https://, иначе Twitch
# OAuth и защищённые куки сессии работать не будут.
NEXTAUTH_URL="https://your-domain.example"

# --- Twitch-приложение (https://dev.twitch.tv/console/apps) ---
# OAuth Redirect URL в настройках приложения должен точно совпадать с:
#   ${NEXTAUTH_URL}/api/auth/callback/twitch
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# --- Порт, на котором приложение слушает на хосте (docker-compose) ---
APP_PORT=3000
